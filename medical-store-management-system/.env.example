# ============================================================
# MEDICAL STORE MANAGEMENT SYSTEM — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Node Environment ---
NODE_ENV=development

# --- Backend API ---
API_PORT=3001
API_HOST=localhost

# --- PostgreSQL Database ---
DATABASE_URL="postgresql://YOUR_PG_USER:YOUR_PG_PASSWORD@localhost:5432/medstore_dev?schema=public"

# --- Session Security ---
# Generate with: openssl rand -hex 64
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_64_CHARS

# Session cookie settings
SESSION_COOKIE_SECURE=false       # Set true in production (requires HTTPS)
SESSION_COOKIE_MAX_AGE_MS=28800000 # 8 hours in milliseconds

# --- CORS ---
CORS_ORIGIN=http://localhost:5180

# --- Frontend Vite ---
VITE_API_BASE_URL=http://localhost:3001/api/v1

# --- Rate Limiting ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# --- Logging ---
LOG_LEVEL=info  # debug | info | warn | error
