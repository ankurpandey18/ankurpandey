generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum RoleName {
  OWNER
  PHARMACIST
  BILLING_STAFF
}

enum PackagingType {
  BASE_UNIT
  PACK
}

enum BatchStatus {
  ACTIVE
  QUARANTINED
  EXPIRED
  DEPLETED
}

enum LocationType {
  MAIN_STORE
  RACK
  SHELF
  CABINET
  REFRIGERATOR
}

enum OperationType {
  OPENING_STOCK
  ADJUSTMENT
  TRANSFER
  STOCK_COUNT
}

enum OperationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum MovementType {
  OPENING_STOCK
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGE
  EXPIRED
  TRANSFER_IN
  TRANSFER_OUT
  STOCK_COUNT_VARIANCE
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id                String        @id @default(uuid()) @db.Uuid
  name              String        @db.VarChar(100)
  email             String        @unique @db.VarChar(255)
  phone             String?       @unique @db.VarChar(20)
  passwordHash      String        @db.Text
  status            AccountStatus @default(ACTIVE)
  mustChangePassword Boolean      @default(false)
  lastLogin         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations (Phase 1)
  roles             UserRole[]
  employeeProfile   EmployeeProfile?
  auditLogsActor    AuditLog[]    @relation("AuditActor")
  loginAttempts     LoginAttempt[]

  // Relations (Phase 2)
  medicinesCreated      Medicine[]          @relation("MedicineCreatedBy")
  batchesCreated        MedicineBatch[]     @relation("BatchCreatedBy")
  operationsRequested   StockOperation[]    @relation("OpRequestedBy")
  operationsApproved    StockOperation[]    @relation("OpApprovedBy")
  movementsCreated      StockMovement[]     @relation("MovementCreatedBy")
  countsCreated         StockCountSession[] @relation("CountCreatedBy")
  countsApproved        StockCountSession[] @relation("CountApprovedBy")

  @@map("users")
  @@index([email])
  @@index([status])
}

// ─── Role ─────────────────────────────────────────────────────────────────────

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

// ─── Permission ───────────────────────────────────────────────────────────────

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())

  roles       RolePermission[]

  @@map("permissions")
}

// ─── UserRole (many-to-many) ──────────────────────────────────────────────────

model UserRole {
  userId     String   @db.Uuid
  roleId     Int
  assignedAt DateTime @default(now())
  assignedBy String?  @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
  @@index([userId])
}

// ─── RolePermission (many-to-many) ───────────────────────────────────────────

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── EmployeeProfile ──────────────────────────────────────────────────────────

model EmployeeProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @db.Uuid
  employeeCode String    @unique @db.VarChar(20)
  joiningDate  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("employee_profiles")
  @@index([employeeCode])
}

// ─── Session (connect-pg-simple compatible) ───────────────────────────────────

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime

  @@map("session")
  @@index([expire])
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @db.VarChar(50)
  entityId   String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  requestId  String?  @db.VarChar(100)
  prevState  Json?
  newState   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@map("audit_logs")
  @@index([actorId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

// ─── LoginAttempt ─────────────────────────────────────────────────────────────

model LoginAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  email     String   @db.VarChar(255)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("login_attempts")
  @@index([email])
  @@index([ipAddress])
  @@index([createdAt(sort: Desc)])
}

// ==============================================================================
// PHASE 2: MEDICINE CATALOGUE & INVENTORY MANAGEMENT
// ==============================================================================

// ─── MedicineCategory ─────────────────────────────────────────────────────────

model MedicineCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  medicines   Medicine[]

  @@map("medicine_categories")
}

// ─── Manufacturer ─────────────────────────────────────────────────────────────

model Manufacturer {
  id            Int        @id @default(autoincrement())
  name          String     @unique @db.VarChar(150)
  code          String     @unique @db.VarChar(50)
  contactPerson String?    @db.VarChar(100)
  email         String?    @db.VarChar(255)
  phone         String?    @db.VarChar(20)
  address       String?    @db.Text
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  medicines     Medicine[]

  @@map("manufacturers")
}

// ─── DosageForm ───────────────────────────────────────────────────────────────

model DosageForm {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  medicines   Medicine[]

  @@map("dosage_forms")
}

// ─── AdministrationRoute ──────────────────────────────────────────────────────

model AdministrationRoute {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  code        String     @unique @db.VarChar(50)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  medicines   Medicine[]

  @@map("administration_routes")
}

// ─── MeasurementUnit ──────────────────────────────────────────────────────────

model MeasurementUnit {
  id           Int                    @id @default(autoincrement())
  name         String                 @unique @db.VarChar(50)
  symbol       String                 @unique @db.VarChar(20)
  description  String?                @db.VarChar(100)
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  compositions MedicineComposition[]

  @@map("measurement_units")
}

// ─── Composition ──────────────────────────────────────────────────────────────

model Composition {
  id          Int                   @id @default(autoincrement())
  name        String                @unique @db.VarChar(150)
  description String?               @db.Text
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  medicines   MedicineComposition[]

  @@map("compositions")
}

// ─── MedicineComposition ──────────────────────────────────────────────────────

model MedicineComposition {
  id            Int              @id @default(autoincrement())
  medicineId    String           @db.Uuid
  compositionId Int
  strengthValue Decimal?         @db.Decimal(10, 4)
  unitId        Int?

  medicine      Medicine         @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  composition   Composition      @relation(fields: [compositionId], references: [id])
  unit          MeasurementUnit? @relation(fields: [unitId], references: [id])

  @@unique([medicineId, compositionId])
  @@map("medicine_compositions")
}

// ─── Medicine ─────────────────────────────────────────────────────────────────

model Medicine {
  id                    String                @id @default(uuid()) @db.Uuid
  sku                   String                @unique @db.VarChar(50)
  brandName             String                @db.VarChar(150)
  genericName           String                @db.VarChar(200)
  displayName           String                @db.VarChar(255)
  categoryId            Int?
  manufacturerId        Int?
  dosageFormId          Int?
  administrationRouteId Int?
  prescriptionRequired  Boolean               @default(false)
  regulatoryCategory    String?               @db.VarChar(50)
  hsnCode               String?               @db.VarChar(20)
  gstRate               Decimal               @default(12.00) @db.Decimal(5, 2)
  baseUnit              String                @default("TABLET") @db.VarChar(30)
  packUnit              String                @default("STRIP") @db.VarChar(30)
  unitsPerPack          Decimal               @default(10.00) @db.Decimal(10, 2)
  minStockLevel         Decimal               @default(10.00) @db.Decimal(12, 2)
  storageConditions     String?               @db.VarChar(255)
  sideEffects           String?               @db.Text
  isActive              Boolean               @default(true)
  createdById           String?               @db.Uuid
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  category              MedicineCategory?     @relation(fields: [categoryId], references: [id])
  manufacturer          Manufacturer?         @relation(fields: [manufacturerId], references: [id])
  dosageForm            DosageForm?           @relation(fields: [dosageFormId], references: [id])
  administrationRoute   AdministrationRoute?  @relation(fields: [administrationRouteId], references: [id])
  createdBy             User?                 @relation("MedicineCreatedBy", fields: [createdById], references: [id])

  compositions          MedicineComposition[]
  barcodes              MedicineBarcode[]
  batches               MedicineBatch[]
  stockBalances         StockBalance[]
  operationItems        StockOperationItem[]
  countItems            StockCountItem[]

  @@map("medicines")
  @@index([brandName])
  @@index([genericName])
  @@index([sku])
  @@index([categoryId])
  @@index([manufacturerId])
  @@index([isActive])
}

// ─── MedicineBarcode ──────────────────────────────────────────────────────────

model MedicineBarcode {
  id            Int           @id @default(autoincrement())
  barcode       String        @unique @db.VarChar(100)
  medicineId    String        @db.Uuid
  packagingType PackagingType @default(BASE_UNIT)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())

  medicine      Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@map("medicine_barcodes")
  @@index([barcode])
  @@index([medicineId])
}

// ─── MedicineBatch ────────────────────────────────────────────────────────────

model MedicineBatch {
  id                   String               @id @default(uuid()) @db.Uuid
  medicineId           String               @db.Uuid
  batchNumber          String               @db.VarChar(100)
  manufacturingDate    DateTime             @db.Date
  expiryDate           DateTime             @db.Date
  mrp                  Decimal              @db.Decimal(12, 2)
  purchasePrice        Decimal              @db.Decimal(12, 2)
  sellingPrice         Decimal              @db.Decimal(12, 2)
  packConversionFactor Decimal              @default(1.00) @db.Decimal(10, 2)
  status               BatchStatus          @default(ACTIVE)
  notes                String?              @db.VarChar(500)
  createdById          String?              @db.Uuid
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  medicine             Medicine             @relation(fields: [medicineId], references: [id])
  createdBy            User?                @relation("BatchCreatedBy", fields: [createdById], references: [id])
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  operationItems       StockOperationItem[]
  countItems           StockCountItem[]

  @@unique([medicineId, batchNumber])
  @@map("medicine_batches")
  @@index([medicineId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([status])
}

// ─── StockLocation ────────────────────────────────────────────────────────────

model StockLocation {
  id               String               @id @default(uuid()) @db.Uuid
  name             String               @db.VarChar(100)
  code             String               @unique @db.VarChar(50)
  type             LocationType         @default(RACK)
  description      String?              @db.VarChar(255)
  parentId         String?              @db.Uuid
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  parent           StockLocation?       @relation("LocationHierarchy", fields: [parentId], references: [id])
  children         StockLocation[]      @relation("LocationHierarchy")
  stockBalances    StockBalance[]
  stockMovements   StockMovement[]
  sourceOperations StockOperationItem[] @relation("SourceLocation")
  destOperations   StockOperationItem[] @relation("DestLocation")
  countSessions    StockCountSession[]

  @@map("stock_locations")
  @@index([code])
  @@index([type])
}

// ─── StockBalance ─────────────────────────────────────────────────────────────

model StockBalance {
  id               String        @id @default(uuid()) @db.Uuid
  medicineId       String        @db.Uuid
  batchId          String        @db.Uuid
  locationId       String        @db.Uuid
  quantityOnHand   Decimal       @default(0.00) @db.Decimal(12, 2)
  reorderThreshold Decimal       @default(10.00) @db.Decimal(12, 2)
  lastMovementAt   DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  medicine         Medicine      @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch @relation(fields: [batchId], references: [id])
  location         StockLocation @relation(fields: [locationId], references: [id])

  @@unique([batchId, locationId])
  @@map("stock_balances")
  @@index([medicineId])
  @@index([batchId])
  @@index([locationId])
}

// ─── StockOperation ───────────────────────────────────────────────────────────

model StockOperation {
  id              String               @id @default(uuid()) @db.Uuid
  operationNumber String               @unique @db.VarChar(50)
  type            OperationType
  status          OperationStatus      @default(DRAFT)
  idempotencyKey  String?              @unique @db.VarChar(100)
  requestedById   String?              @db.Uuid
  approvedById    String?              @db.Uuid
  notes           String?              @db.Text
  rejectionReason String?              @db.VarChar(500)
  metadata        Json?
  submittedAt     DateTime?
  approvedAt      DateTime?
  postedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  requestedBy     User?                @relation("OpRequestedBy", fields: [requestedById], references: [id])
  approvedBy      User?                @relation("OpApprovedBy", fields: [approvedById], references: [id])
  items           StockOperationItem[]
  movements       StockMovement[]

  @@map("stock_operations")
  @@index([operationNumber])
  @@index([type])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ─── StockOperationItem ───────────────────────────────────────────────────────

model StockOperationItem {
  id                    String         @id @default(uuid()) @db.Uuid
  operationId           String         @db.Uuid
  medicineId            String         @db.Uuid
  batchId               String         @db.Uuid
  sourceLocationId      String?        @db.Uuid
  destinationLocationId String?        @db.Uuid
  quantity              Decimal        @db.Decimal(12, 2)
  unitPrice             Decimal?       @db.Decimal(12, 2)
  reason                String?        @db.VarChar(255)
  notes                 String?        @db.VarChar(500)

  operation             StockOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  medicine              Medicine       @relation(fields: [medicineId], references: [id])
  batch                 MedicineBatch  @relation(fields: [batchId], references: [id])
  sourceLocation        StockLocation? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocation          StockLocation? @relation("DestLocation", fields: [destinationLocationId], references: [id])

  @@map("stock_operation_items")
  @@index([operationId])
  @@index([batchId])
}

// ─── StockMovement (The Immutable Ledger) ─────────────────────────────────────

model StockMovement {
  id             String          @id @default(uuid()) @db.Uuid
  batchId        String          @db.Uuid
  locationId     String          @db.Uuid
  operationId    String?         @db.Uuid
  movementType   MovementType
  quantityChange Decimal         @db.Decimal(12, 2) // Signed: + for incoming, - for outgoing
  quantityBefore Decimal         @db.Decimal(12, 2)
  quantityAfter  Decimal         @db.Decimal(12, 2)
  referenceDoc   String?         @db.VarChar(100)
  reason         String?         @db.VarChar(255)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  batch          MedicineBatch   @relation(fields: [batchId], references: [id])
  location       StockLocation   @relation(fields: [locationId], references: [id])
  operation      StockOperation? @relation(fields: [operationId], references: [id])
  createdBy      User?           @relation("MovementCreatedBy", fields: [createdById], references: [id])

  @@map("stock_movements")
  @@index([batchId])
  @@index([locationId])
  @@index([operationId])
  @@index([movementType])
  @@index([createdAt(sort: Desc)])
}

// ─── StockCountSession ────────────────────────────────────────────────────────

model StockCountSession {
  id              String           @id @default(uuid()) @db.Uuid
  sessionNumber   String           @unique @db.VarChar(50)
  locationId      String           @db.Uuid
  status          OperationStatus  @default(DRAFT)
  createdById     String?          @db.Uuid
  approvedById    String?          @db.Uuid
  notes           String?          @db.Text
  rejectionReason String?          @db.VarChar(500)
  submittedAt     DateTime?
  approvedAt      DateTime?
  postedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  location        StockLocation    @relation(fields: [locationId], references: [id])
  createdBy       User?            @relation("CountCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?            @relation("CountApprovedBy", fields: [approvedById], references: [id])
  items           StockCountItem[]

  @@map("stock_count_sessions")
  @@index([sessionNumber])
  @@index([locationId])
  @@index([status])
}

// ─── StockCountItem ───────────────────────────────────────────────────────────

model StockCountItem {
  id               String            @id @default(uuid()) @db.Uuid
  sessionId        String            @db.Uuid
  medicineId       String            @db.Uuid
  batchId          String            @db.Uuid
  systemQuantity   Decimal           @db.Decimal(12, 2)
  countedQuantity  Decimal           @db.Decimal(12, 2)
  varianceQuantity Decimal           @db.Decimal(12, 2) // counted - system
  notes            String?           @db.VarChar(255)

  session          StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  medicine         Medicine          @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch     @relation(fields: [batchId], references: [id])

  @@map("stock_count_items")
  @@index([sessionId])
  @@index([batchId])
}
